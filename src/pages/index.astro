---
import { getCountries } from '../lib/countries.js';

const countries = getCountries();

const byName = [...countries].sort((a, b) => a.name.localeCompare(b.name));
const median = countries[Math.floor(countries.length / 2)].ratio;
const cheaper = countries.filter((c) => c.ratio < 0.5).length;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Fair price, everywhere</title>
  <meta name="description" content="What a US-dollar price should cost in every country, adjusted for purchasing power. Live calculator and full World Bank price-level data." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:," />
</head>
<body>
  <header class="top">
    <span class="mark">ppp-pricing</span>
  </header>

  <main>
    <section class="hero">
      <p class="sentence">
        A <span class="field money"><span aria-hidden="true">$</span><input id="price" type="number" inputmode="decimal" min="0" step="1" value="10" aria-label="Price in US dollars" /></span>
        product should cost about <output id="result" for="price country smoothing">$2.66</output>{" "}
        in <span class="field"><span class="dd">
          <button type="button" id="country-btn" aria-haspopup="listbox" aria-expanded="false">{byName.find((c) => c.iso3 === 'LKA').name}</button>
          <select id="country" hidden>
            {byName.map((c) => <option value={c.iso3} selected={c.iso3 === 'LKA'}>{c.name}</option>)}
          </select>
          <ul id="country-list" class="country-list" role="listbox" hidden>
            {byName.map((c) => <li role="option" data-iso3={c.iso3} aria-selected={c.iso3 === 'LKA'}>{c.name}</li>)}
          </ul>
        </span></span>.
      </p>
      <span id="ruler" class="sentence" aria-hidden="true"></span>
      <p class="why" id="why">
        Goods in <b data-name>Sri Lanka</b> cost about <b data-pct>27%</b> of what they cost in the United States.
      </p>

      <div class="controls">
        <label class="ctl">
          <span>Smoothing <b id="smoothing-value">0</b></span>
          <input id="smoothing" type="range" min="0" max="1" step="0.05" value="0" />
          <small>Off by default. Raise it to pull prices back toward your original.</small>
        </label>
        <fieldset class="ctl">
          <legend>Rounding</legend>
          <label><input type="radio" name="rounding" value="none" checked /> Exact</label>
          <label><input type="radio" name="rounding" value="currency" /> Cents</label>
          <label><input type="radio" name="rounding" value="pretty" /> Pretty (4.49, 43, 135)</label>
        </fieldset>
      </div>
    </section>

    <section class="ladder">
      <div class="ladder-head">
        <h2>Every country, one price level</h2>
        <p>{countries.length} countries from the World Bank. Half sit below <b>{median.toFixed(2)}</b>; {cheaper} are under half the US price level. Bars show the price level, the number on the right is your fair price.</p>
        <input id="filter" type="search" placeholder="Find a country" aria-label="Find a country" />
      </div>
      <ol id="rows">
        {countries.map((c) => (
          <li data-iso3={c.iso3} data-name={c.name.toLowerCase()} data-ratio={c.ratio} class:list={{ high: c.ratio > 1, current: c.iso3 === 'LKA' }}>
            <a href={`/country/${c.slug}/`}>
              <span class="name">{c.name}</span>
              <span class="bar"><i style={`width:${Math.min(c.ratio, 1.5) / 1.5 * 100}%`}></i></span>
              <span class="ratio">{c.ratio.toFixed(2)}</span>
              <span class="price"></span>
            </a>
          </li>
        ))}
      </ol>
      <p class="note">Values near zero (Venezuela, Turkmenistan, Liberia, Zimbabwe) and far above one (Iran, Sudan) come from mismatched official exchange rates in the source series and are not useful for pricing.</p>
    </section>

    <section class="method">
      <h2>How the number is made</h2>
      <div class="cols">
        <div>
          <h3>Price level ratio</h3>
          <p>The World Bank publishes, for every country, how many units of local currency buy what one US dollar buys at home (the PPP conversion factor, <code>PA.NUS.PPP</code>) and the official exchange rate (<code>PA.NUS.FCRF</code>). Dividing one by the other gives a price level: 1.0 means prices match the US, 0.27 means goods cost about a quarter as much.</p>
        </div>
        <div>
          <h3>Smoothing</h3>
          <p>An optional blend back toward the original price, for when the raw ratio feels too aggressive:</p>
          <p class="formula">fair = price × (ratio + (1 − ratio) × smoothing)</p>
          <p>Off by default (0), so every number on this page is the raw ratio × your price. At 0.2, a country with ratio 0.27 would get 0.42× instead.</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>Built by <a href="https://github.com/sachithrrra">sachithrrra</a>. MIT licensed. Data © World Bank, CC BY 4.0. <a href="https://github.com/sachithrrra/ppp-pricing">GitHub</a></p>
  </footer>

  <script>
    import ppp from '../../index.js';

    const $ = (id) => document.getElementById(id);
    const price = $('price'), country = $('country'), smoothing = $('smoothing'), result = $('result');
    const why = $('why'), rows = $('rows'), filter = $('filter');
    const countryBtn = $('country-btn'), countryList = $('country-list');
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 2 });
    const exact = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 6 });

    // Size the inline fields to their text by measuring it in a hidden span with the same font.
    const ruler = document.getElementById("ruler");
    function fit(el, text) {
      ruler.textContent = text;
      el.style.width = ruler.offsetWidth + 4 + "px";
    }

    function render() {
      const p = Number(price.value) || 0;
      const s = Number(smoothing.value);
      const r = document.querySelector('input[name=rounding]:checked').value;
      const iso3 = country.value;
      const fmt = r === 'none' ? exact : money;

      result.textContent = fmt.format(ppp(p, iso3, s, r));
      fit(price, price.value);
      countryBtn.textContent = country.selectedOptions[0].text;
      $('smoothing-value').textContent = String(s);
      why.querySelector('[data-name]').textContent = country.selectedOptions[0].text;
      why.querySelector('[data-pct]').textContent = Math.round(ppp.factor(iso3) * 100) + '%';

      for (const li of rows.children) {
        li.querySelector('.price').textContent = money.format(ppp(p, li.dataset.iso3, s, r));
        li.classList.toggle('current', li.dataset.iso3 === iso3);
      }
    }

    document.querySelectorAll('#price, #country, #smoothing, input[name=rounding]').forEach((el) => el.addEventListener('input', render));

    function closeCountryList() {
      countryList.hidden = true;
      countryBtn.setAttribute('aria-expanded', 'false');
    }
    countryBtn.addEventListener('click', () => {
      const open = countryList.hidden;
      if (open) {
        const r = countryBtn.getBoundingClientRect();
        countryList.style.top = r.bottom + 6 + 'px';
        countryList.style.left = r.left + 'px';
      }
      countryList.hidden = !open;
      countryBtn.setAttribute('aria-expanded', String(open));
      if (open) countryList.querySelector(`[data-iso3="${country.value}"]`)?.scrollIntoView({ block: 'nearest' });
    });
    window.addEventListener('scroll', (e) => { if (!countryList.contains(e.target)) closeCountryList(); }, true);
    countryList.addEventListener('click', (e) => {
      const li = e.target.closest('li');
      if (!li) return;
      countryList.querySelector('[aria-selected=true]')?.setAttribute('aria-selected', 'false');
      li.setAttribute('aria-selected', 'true');
      country.value = li.dataset.iso3;
      render();
      closeCountryList();
      countryBtn.focus();
    });
    document.addEventListener('click', (e) => {
      if (!countryList.hidden && !e.target.closest('.field')) closeCountryList();
    });
    countryBtn.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCountryList(); });


    filter.addEventListener('input', () => {
      const q = filter.value.trim().toLowerCase();
      for (const li of rows.children) li.hidden = q !== '' && !li.dataset.name.includes(q);
    });

    render();
    document.fonts.ready.then(render); // re-measure once Valley Sans has loaded
  </script>

  <style is:global>
    :root {
      --bg: #f2f4f1;
      --paper: #ffffff;
      --ink: #15211b;
      --muted: #66736c;
      --line: #d7ddd8;
      --green: #1f6f50;
      --green-soft: #d9e9df;
      --gold: #b8871c;
      --gold-soft: #f1e4c2;
      --font: 'Valley Sans', system-ui, sans-serif;
    }
    * { box-sizing: border-box; }
    html { background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 17px; line-height: 1.5; -webkit-text-size-adjust: 100%; }
    body { margin: 0; }
    a { color: inherit; text-decoration-color: var(--line); text-underline-offset: 3px; }
    a:hover { text-decoration-color: var(--green); }
    h2, h3 { font-family: var(--font); font-weight: 500; line-height: 1.15; margin: 0 0 .5rem; }
    h2 { font-size: clamp(1.7rem, 3vw, 2.4rem); letter-spacing: -.01em; }
    h3 { font-size: 1.25rem; }
    p { margin: 0 0 1rem; max-width: 62ch; }
    code { font-family: ui-monospace, Menlo, monospace; font-size: .9em; background: var(--paper); padding: .05em .35em; border-radius: 3px; }
    :focus-visible { outline: 2px solid var(--green); outline-offset: 2px; }

    .top { display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem clamp(16px, 4vw, 48px); font-size: .95rem; }
    .mark { font-family: var(--font); font-weight: 500; font-size: 1.4rem; letter-spacing: -.02em; }

    main { padding: 0 clamp(16px, 4vw, 48px) 4rem; max-width: 1200px; margin: 0 auto; }

    /* Hero: the sentence is the calculator */
    .hero { padding: clamp(2rem, 8vh, 6rem) 0 3rem; }
    .sentence { font-family: var(--font); font-weight: 300; font-size: clamp(1.9rem, 5.2vw, 4.4rem); line-height: 1.22; letter-spacing: -.015em; max-width: 22ch; margin: 0 0 1.25rem; }
    #ruler { position: absolute; visibility: hidden; white-space: pre; margin: 0; font-variant-numeric: tabular-nums; }
    .field { display: inline-flex; align-items: baseline; border-bottom: 2px solid var(--ink); padding: 0 .1em; }
    .field input, .field button {
      font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; width: auto;
      appearance: none; -webkit-appearance: none; -moz-appearance: textfield; cursor: pointer; white-space: nowrap;
    }
    .field input::-webkit-outer-spin-button, .field input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
    .field input { width: 2ch; text-align: left; cursor: text; }
    .field:has(button[aria-expanded=true]), .field:focus-within { border-bottom-color: var(--green); }
    .dd { display: inline-block; }
    .country-list {
      position: fixed; z-index: 10; min-width: 12rem; max-height: 16rem;
      overflow-y: auto; margin: 0; padding: .25rem 0; list-style: none;
      font-family: var(--font); font-size: 1rem; font-weight: 400; line-height: 1.4;
      background: var(--paper); border: 1px solid var(--line); border-radius: 6px; box-shadow: 0 8px 24px rgba(0,0,0,.15);
    }
    .country-list[hidden] { display: none; }
    .country-list li { padding: .4rem .9rem; cursor: pointer; white-space: nowrap; }
    .country-list li:hover { background: var(--green-soft); }
    .country-list li[aria-selected=true] { font-weight: 600; }
    .money { font-variant-numeric: tabular-nums; }
    #result { color: var(--green); font-weight: 600; white-space: nowrap; }
    .why { color: var(--muted); font-size: 1.05rem; margin-bottom: 2.5rem; }
    .why b { color: var(--ink); font-weight: 500; }

    .controls { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 2rem 3rem; font-size: .95rem; }
    .ctl { display: flex; flex-direction: column; gap: .4rem; border: 0; padding: 0; margin: 0; min-width: 0; }
    .ctl > span, .ctl legend { font-weight: 500; padding: 0; }
    .ctl small { color: var(--muted); }
    .ctl input[type=range] { width: min(320px, 80vw); accent-color: var(--green); }
    fieldset.ctl { flex-direction: row; flex-wrap: wrap; align-items: center; gap: .3rem 1.25rem; }
    fieldset.ctl legend { float: left; width: 100%; margin-bottom: .4rem; line-height: 1.5; }
    fieldset.ctl label { display: inline-flex; align-items: center; gap: .35rem; }
    fieldset.ctl input { accent-color: var(--green); margin: 0; }

    /* Ladder */
    .ladder { border-top: 1px solid var(--line); padding-top: 3rem; margin-top: 2rem; }
    .ladder-head { display: grid; grid-template-columns: 1fr auto; gap: 1rem 3rem; align-items: end; margin-bottom: 1.5rem; }
    .ladder-head h2, .ladder-head p { grid-column: 1; }
    .ladder-head p { margin: 0; color: var(--muted); }
    .ladder-head p b { color: var(--ink); font-weight: 500; }
    #filter { grid-column: 2; grid-row: 1 / 3; font: inherit; padding: .55rem .8rem; border: 1px solid var(--line); border-radius: 6px; background: var(--paper); width: 16rem; max-width: 100%; }
    #rows { list-style: none; margin: 0; padding: 0; }
    #rows li { border-top: 1px solid var(--line); }
    #rows li:last-child { border-bottom: 1px solid var(--line); }
    #rows a {
      all: unset; display: grid; grid-template-columns: minmax(9rem, 16rem) 1fr 3.5rem 7rem; align-items: center; gap: 1rem;
      width: 100%; padding: .45rem 0; cursor: pointer; font-variant-numeric: tabular-nums; font-size: .95rem;
    }
    #rows a:hover .name { color: var(--green); }
    #rows a:focus-visible { outline: 2px solid var(--green); outline-offset: -2px; }
    .name { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .bar { display: block; height: 10px; background: var(--paper); border-radius: 2px; overflow: hidden; }
    .bar i { display: block; height: 100%; background: var(--green); min-width: 2px; }
    .high .bar i { background: var(--gold); }
    .ratio { color: var(--muted); text-align: right; }
    .price { text-align: right; font-weight: 500; }
    .current { background: var(--green-soft); box-shadow: 0 0 0 6px var(--green-soft); border-radius: 3px; }
    .current .name { font-weight: 600; }
    .high.current { background: var(--gold-soft); box-shadow: 0 0 0 6px var(--gold-soft); }
    .note { color: var(--muted); font-size: .9rem; margin-top: 1.25rem; max-width: 70ch; }

    /* Method */
    .method { border-top: 1px solid var(--line); padding-top: 3rem; margin-top: 4rem; }
    .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr)); gap: 2.5rem; }
    .formula { font-family: var(--font); font-size: 1.3rem; padding: .75rem 1rem; background: var(--paper); border-left: 3px solid var(--green); }

    footer { padding: 2rem clamp(16px, 4vw, 48px); border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
    footer p { margin: 0; }

    @media (max-width: 640px) {
      .ladder-head { grid-template-columns: 1fr; }
      #filter { grid-column: 1; grid-row: auto; width: 100%; }
      #rows a { grid-template-columns: 1fr auto; grid-template-rows: auto auto; gap: .2rem .75rem; padding: .6rem 0; }
      .name { grid-column: 1; }
      .price { grid-column: 2; grid-row: 1; }
      .bar { grid-column: 1 / 3; grid-row: 2; }
      .ratio { display: none; }
      .current { box-shadow: 0 0 0 8px var(--green-soft); }
    }
    @media (prefers-reduced-motion: no-preference) {
      .bar i { transition: width .3s ease; }
    }
  </style>
</body>
</html>
