---
import { getCountries, getHistory } from '../../lib/countries.js';

export function getStaticPaths() {
  return getCountries().map((c) => ({ params: { slug: c.slug }, props: { country: c } }));
}

const { country } = Astro.props;
const pct = Math.round(country.ratio * 100);
const title = `US price in ${country.name} — Purchasing Power Parity`;
const description = `Goods and services in ${country.name} cost about ${pct}% of US prices, adjusted for purchasing power parity (World Bank data). Convert any US price to a fair local price.`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;

const history = getHistory(country.iso3);

// Chart geometry: a thin 2px line over the yearly price level ratio, oldest to newest.
const chartW = 640, chartH = 220, padL = 34, padR = 12, padT = 16, padB = 24;
const values = history.map((h) => h.ratio);
const yMin = Math.min(...values, country.ratio);
const yMax = Math.max(...values, country.ratio);
const ySpan = yMax - yMin || 1;
const x = (i) => padL + (i / (history.length - 1 || 1)) * (chartW - padL - padR);
const y = (v) => padT + (1 - (v - yMin) / ySpan) * (chartH - padT - padB);
const points = history.map((h, i) => [x(i), y(h.ratio)]);
const linePath = points.map(([px, py], i) => `${i === 0 ? 'M' : 'L'}${px.toFixed(1)},${py.toFixed(1)}`).join(' ');
const yTicks = [yMin, (yMin + yMax) / 2, yMax];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(`${base}/country/${country.slug}/`, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Valley+Sans:wght@300..700&display=swap" rel="stylesheet" />
  <link rel="icon" href="data:," />
  <style>
    :root { --bg: #f2f4f1; --paper: #fff; --ink: #15211b; --muted: #66736c; --line: #d7ddd8; --green: #1f6f50; --font: 'Valley Sans', system-ui, sans-serif; }
    * { box-sizing: border-box; }
    html { background: var(--bg); color: var(--ink); font-family: var(--font); font-size: 17px; line-height: 1.5; }
    body { margin: 0; }
    a { color: var(--green); }
    .top { display: flex; justify-content: space-between; align-items: baseline; padding: 1.25rem clamp(16px, 4vw, 48px); font-size: .95rem; }
    .mark { font-weight: 500; font-size: 1.4rem; letter-spacing: -.02em; }
    main { padding: 0 clamp(16px, 4vw, 48px) 4rem; max-width: 700px; margin: 0 auto; }
    h1 { font-weight: 300; font-size: clamp(1.7rem, 4vw, 2.6rem); line-height: 1.25; letter-spacing: -.015em; margin: 1rem 0 1.5rem; }
    .stat { color: var(--green); font-weight: 600; }
    .field { display: inline-flex; align-items: baseline; border-bottom: 2px solid var(--ink); padding: 0 .1em; }
    .field input { font: inherit; color: inherit; background: none; border: 0; padding: 0; width: 4ch; text-align: left; }
    #result { color: var(--green); font-weight: 600; }
    .back { display: inline-block; margin-top: 2rem; }
    footer { padding: 2rem clamp(16px, 4vw, 48px); border-top: 1px solid var(--line); color: var(--muted); font-size: .9rem; }
    footer p { margin: 0; }

    .chart-card { margin-top: 2.5rem; }
    .chart-card h2 { font-size: 1rem; font-weight: 600; margin: 0 0 .75rem; color: var(--muted); }
    .chart-wrap { position: relative; }
    .chart-wrap svg { width: 100%; height: auto; display: block; overflow: visible; }
    .chart-wrap .grid line { stroke: var(--line); stroke-width: 1; }
    .chart-wrap .tick { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
    .chart-wrap .series { fill: none; stroke: var(--green); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
    .chart-wrap .end-dot { fill: var(--green); stroke: var(--paper); stroke-width: 2; }
    .chart-wrap .end-label { fill: var(--ink); font-weight: 600; font-size: 12px; }
    .chart-wrap .crosshair { stroke: var(--muted); stroke-width: 1; opacity: 0; pointer-events: none; }
    .chart-wrap .hover-dot { fill: var(--green); stroke: var(--paper); stroke-width: 2; opacity: 0; pointer-events: none; }
    .chart-wrap .hit { fill: transparent; }
    .tooltip { position: absolute; pointer-events: none; opacity: 0; transform: translate(-50%, -100%); background: var(--ink); color: #fff; font-size: .8rem; padding: .35rem .55rem; border-radius: 6px; white-space: nowrap; top: 0; left: 0; transition: opacity .1s; }
    .tooltip strong { font-weight: 600; }
  </style>
</head>
<body>
  <header class="top">
    <a href={home} class="mark">ppp-pricing</a>
  </header>
  <main>
    <h1>Goods in {country.name} cost about <span class="stat">{pct}%</span> of US prices.</h1>
    <p>
      A <span class="field"><span aria-hidden="true">$</span><input id="price" type="number" min="0" step="1" value="10" aria-label="Price in US dollars" /></span>
      product in the US should cost about <output id="result" data-ratio={country.ratio}>$0.00</output> in {country.name}, based on the World Bank's purchasing power parity data.
    </p>
    <p>This reflects the price level ratio for {country.name} — how many local goods a dollar actually buys there compared to the US — not the raw currency exchange rate.</p>

    {history.length > 1 && (
      <section class="chart-card">
        <h2>Price level ratio, {history[0].year}–{history[history.length - 1].year}</h2>
        <div class="chart-wrap" id="chart">
          <svg viewBox={`0 0 ${chartW} ${chartH}`} role="img" aria-label={`Price level ratio for ${country.name} from ${history[0].year} to ${history[history.length - 1].year}`}>
            <g class="grid">
              {yTicks.map((v) => (
                <>
                  <line x1={padL} x2={chartW - padR} y1={y(v)} y2={y(v)} />
                  <text class="tick" x={padL - 6} y={y(v) + 3} text-anchor="end">{v.toFixed(2)}</text>
                </>
              ))}
            </g>
            <path class="series" d={linePath} />
            <circle class="end-dot" r="5" cx={points[points.length - 1][0]} cy={points[points.length - 1][1]} />
            <text class="end-label" x={points[points.length - 1][0] - 8} y={points[points.length - 1][1] - 10} text-anchor="end">{country.ratio.toFixed(2)}</text>
            <line class="crosshair" id="crosshair" x1="0" x2="0" y1={padT} y2={chartH - padB} />
            <circle class="hover-dot" id="hover-dot" r="5" />
            {points.map(([px], i) => (
              <rect class="hit" x={Math.max(padL, px - (chartW - padL - padR) / (2 * (history.length - 1 || 1)))}
                    y={padT} width={(chartW - padL - padR) / (history.length - 1 || 1)} height={chartH - padT - padB}
                    data-year={history[i].year} data-ratio={history[i].ratio} data-x={px} data-y={y(history[i].ratio)} />
            ))}
          </svg>
          <div class="tooltip" id="tooltip"><strong id="tooltip-value"></strong> in <span id="tooltip-year"></span></div>
        </div>
      </section>
    )}

    <a class="back" href={home}>&larr; See every country</a>
  </main>
  <footer>
    <p>Made by <a href="https://sach.cc">Sachithra Pushpawela</a>. Data © World Bank, CC BY 4.0. <a href="https://github.com/sachithrrra/ppp-pricing">GitHub</a></p>
  </footer>
  <script>
    const price = document.getElementById('price');
    const result = document.getElementById('result');
    const ratio = Number(result.dataset.ratio);
    const money = new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' });
    const render = () => { result.textContent = money.format((Number(price.value) || 0) * ratio); };
    price.addEventListener('input', render);
    render();

    const chart = document.getElementById('chart');
    if (chart) {
      const svg = chart.querySelector('svg');
      const crosshair = document.getElementById('crosshair');
      const hoverDot = document.getElementById('hover-dot');
      const tooltip = document.getElementById('tooltip');
      const tooltipValue = document.getElementById('tooltip-value');
      const tooltipYear = document.getElementById('tooltip-year');

      const show = (hit) => {
        const px = Number(hit.dataset.x), py = Number(hit.dataset.y);
        crosshair.setAttribute('x1', px); crosshair.setAttribute('x2', px);
        crosshair.style.opacity = 1;
        hoverDot.setAttribute('cx', px); hoverDot.setAttribute('cy', py);
        hoverDot.style.opacity = 1;
        tooltipValue.textContent = Number(hit.dataset.ratio).toFixed(2);
        tooltipYear.textContent = hit.dataset.year;
        const rect = svg.getBoundingClientRect();
        const scale = rect.width / svg.viewBox.baseVal.width;
        tooltip.style.left = `${px * scale}px`;
        tooltip.style.top = `${py * scale - 8}px`;
        tooltip.style.opacity = 1;
      };
      const hide = () => {
        crosshair.style.opacity = 0;
        hoverDot.style.opacity = 0;
        tooltip.style.opacity = 0;
      };

      chart.querySelectorAll('.hit').forEach((hit) => {
        hit.addEventListener('pointerenter', () => show(hit));
        hit.addEventListener('focus', () => show(hit));
        hit.setAttribute('tabindex', '0');
      });
      chart.addEventListener('pointerleave', hide);
      chart.addEventListener('focusout', hide);
    }
  </script>
</body>
</html>
